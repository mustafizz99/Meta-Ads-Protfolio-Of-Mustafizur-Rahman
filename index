<script>
  // Count-up animation for hero floating badges
  function animateCount(el, end, duration, formatter){
    var start = 0;
    var startTime = null;
    function step(ts){
      if(!startTime) startTime = ts;
      var progress = Math.min((ts - startTime) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      var val = start + (end - start) * eased;
      el.textContent = formatter(val);
      if(progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  window.addEventListener('load', function(){
    var convEl = document.getElementById('countConv');
    var costEl = document.getElementById('countCost');
    if(convEl){
      animateCount(convEl, 6256, 1600, function(v){
        return Math.round(v).toLocaleString() + '+';
      });
    }
    if(costEl){
      animateCount(costEl, 0.04, 1600, function(v){
        return '$' + v.toFixed(2) + ' Avg CPR';
      });
    }
  });
</script>

