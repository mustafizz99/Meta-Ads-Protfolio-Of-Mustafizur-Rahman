<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Md Mustafizur Rahman | Meta Ads Specialist</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0E17;
    --bg-alt:#0D1220;
    --card:#121826;
    --card-border:#1E2A3D;
    --text:#F5F7FA;
    --text-soft:#93A1B7;
    --blue:#3B82F6;
    --teal:#2DD4BF;
    --green:#22C55E;
    --grad:linear-gradient(90deg,var(--blue),var(--teal));
  }
  *{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:"Inter",sans-serif;
    font-size:16px;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,h4{ margin:0; font-weight:800; color:var(--text); }
  a{ color:inherit; text-decoration:none; }
  ul{ margin:0; padding:0; list-style:none; }
  .wrap{ max-width:1180px; margin:0 auto; padding:0 32px; }
  .grad-text{ background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .center{ text-align:center; }
  .section-tag{ font-size:13px; letter-spacing:0.05em; color:var(--blue); font-weight:700; text-transform:uppercase; }
  .section-sub{ margin-top:14px; color:var(--text-soft); font-size:15.5px; max-width:560px; }
  .underline{ width:60px; height:3px; background:var(--grad); border-radius:2px; margin-top:10px; }
  .center .underline{ margin-left:auto; margin-right:auto; }

  /* ---- Header ---- */
  header{
    position:sticky; top:0; z-index:20;
    background:rgba(10,14,23,0.9); backdrop-filter:blur(8px);
    border-bottom:1px solid var(--card-border);
    padding:18px 0;
  }
  header .wrap{ display:flex; align-items:center; justify-content:space-between; gap:20px; }
  .brand{ font-weight:800; font-size:19px; }
  .brand span{ background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent; }
  nav{ display:flex; gap:26px; }
  nav a{ font-size:14.5px; color:#C7D0DE; font-weight:500; }
  nav a:hover{ color:var(--teal); }
  .btn-pill{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--blue); color:#fff; font-weight:600; font-size:14px;
    padding:11px 22px; border-radius:999px; white-space:nowrap;
    transition:opacity .2s ease;
  }
  .btn-pill:hover{ opacity:0.88; }
  .btn-ghost{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--card); border:1px solid var(--card-border); color:var(--text);
    font-weight:600; font-size:14px; padding:11px 22px; border-radius:999px;
  }

  /* ---- Hero ---- */
  .hero{ padding:80px 0 60px; }
  .hero .wrap{ display:grid; grid-template-columns:1.15fr 0.85fr; gap:56px; align-items:center; }
  .badge-pill{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--card); border:1px solid var(--card-border);
    padding:8px 16px; border-radius:999px; font-size:12.5px; font-weight:700;
    letter-spacing:0.04em; color:var(--blue);
  }
  .badge-pill .dot{ width:7px; height:7px; border-radius:50%; background:var(--teal); }
  .hero h1{ font-size:44px; line-height:1.2; margin-top:20px; }
  .hero h1 .line2{ display:block; }
  .hero .specialized{ margin-top:16px; font-size:20px; font-weight:600; color:var(--text); }
  .hero .specialized span{ background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .hero p.lede{ margin-top:18px; color:var(--text-soft); font-size:15.5px; max-width:480px; }
  .hero .actions{ margin-top:30px; display:flex; gap:14px; flex-wrap:wrap; }
  .verified{ margin-top:40px; }
  .verified .lbl{ font-size:12px; letter-spacing:0.06em; color:var(--text-soft); font-weight:700; margin-bottom:12px; }
  .verified-row{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .v-pill{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--card); border:1px solid var(--card-border);
    padding:8px 14px; border-radius:999px; font-size:13px; font-weight:600; color:var(--teal);
  }
  .v-circle{
    width:38px; height:38px; border-radius:50%;
    background:var(--card); border:1px solid var(--card-border);
    display:flex; align-items:center; justify-content:center;
  }

  .hero-photo-wrap{ position:relative; display:flex; justify-content:center; }
  .photo-ring{
    width:100%; max-width:340px; aspect-ratio:1/1; border-radius:50%;
    padding:6px; background:conic-gradient(from 180deg, var(--blue), var(--teal), var(--blue));
    box-shadow:0 0 50px rgba(45,212,191,0.25);
  }
  .photo-ring img{ width:100%; height:100%; object-fit:cover; border-radius:50%; display:block; }
  .float-badge{
    position:absolute; background:var(--card); border:1px solid var(--card-border);
    border-radius:12px; padding:10px 14px; display:flex; align-items:center; gap:10px;
    box-shadow:0 8px 24px rgba(0,0,0,0.35);
    animation:floatBob 4.5s ease-in-out infinite;
  }
  .float-badge .fb-icon{ width:30px; height:30px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; animation:iconPulse 2.4s ease-in-out infinite; }
  .float-badge .fb-label{ font-size:11px; color:var(--text-soft); }
  .float-badge .fb-value{ font-size:13.5px; font-weight:700; }
  .float-badge.top{ top:6%; left:-6%; animation-delay:0s; }
  .float-badge.bottom{ bottom:6%; right:-8%; animation-delay:1.4s; }
  @keyframes floatBob{
    0%,100%{ transform:translateY(0); }
    50%{ transform:translateY(-10px); }
  }
  @keyframes iconPulse{
    0%,100%{ box-shadow:0 0 0 0 rgba(45,212,191,0.35); }
    50%{ box-shadow:0 0 0 6px rgba(45,212,191,0); }
  }
  @media (prefers-reduced-motion:reduce){
    .float-badge, .float-badge .fb-icon{ animation:none; }
  }

  /* ---- About ---- */
  .about{ padding:80px 0; border-top:1px solid var(--card-border); }
  .about-grid{ margin-top:40px; display:grid; grid-template-columns:1.1fr 0.9fr; gap:24px; }
  .about-card{ background:var(--card); border:1px solid var(--card-border); border-radius:16px; padding:32px; }
  .about-card h3{ font-size:22px; line-height:1.3; }
  .about-card p{ margin-top:16px; color:var(--text-soft); font-size:14.5px; }
  .about-facts{ margin-top:24px; padding-top:22px; border-top:1px solid var(--card-border); display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  .about-facts .fk{ font-size:12px; color:var(--text-soft); }
  .about-facts .fv{ font-size:14px; font-weight:600; margin-top:3px; }
  .stat-grid{ display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  .stat-card{ background:var(--card); border:1px solid var(--card-border); border-radius:16px; padding:26px; text-align:center; }
  .stat-icon{ width:44px; height:44px; border-radius:50%; margin:0 auto 14px; display:flex; align-items:center; justify-content:center; }
  .stat-num{ font-size:26px; font-weight:800; }
  .stat-label{ margin-top:6px; font-size:13px; color:var(--text-soft); }

  /* ---- Skills ---- */
  .skills{ padding:80px 0; border-top:1px solid var(--card-border); }
  .skills-grid{ margin-top:40px; display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
  .skill-card{ background:var(--card); border:1px solid var(--card-border); border-radius:14px; padding:22px; }
  .skill-top{ display:flex; align-items:center; gap:12px; }
  .skill-icon{ width:38px; height:38px; border-radius:8px; background:#0E1A2B; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .skill-name{ font-size:14.5px; font-weight:600; flex:1; }
  .skill-pct{ font-size:13px; font-weight:700; color:var(--teal); }
  .skill-bar{ margin-top:14px; height:6px; background:#1B2436; border-radius:4px; overflow:hidden; }
  .skill-bar-fill{ height:100%; background:var(--grad); border-radius:4px; }

  /* ---- Services ---- */
  .services{ padding:80px 0; border-top:1px solid var(--card-border); }
  .services-grid{ margin-top:40px; display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
  .service-card{ background:var(--card); border:1px solid var(--card-border); border-radius:16px; padding:28px; }
  .service-icon{ width:46px; height:46px; border-radius:10px; background:#0E1A2B; display:flex; align-items:center; justify-content:center; }
  .service-card h4{ margin-top:18px; font-size:17px; }
  .service-card p{ margin-top:10px; font-size:14px; color:var(--text-soft); }

  /* ---- Portfolio ---- */
  .portfolio{ padding:80px 0; border-top:1px solid var(--card-border); }
  .filter-row{ margin-top:32px; display:flex; gap:10px; justify-content:center; flex-wrap:wrap; }
  .filter-btn{
    background:var(--card); border:1px solid var(--card-border); color:var(--text-soft);
    padding:9px 20px; border-radius:999px; font-size:13.5px; font-weight:600; cursor:pointer;
  }
  .filter-btn.active{ background:var(--blue); color:#fff; border-color:var(--blue); }
  .proof-grid{ margin-top:36px; display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
  .proof-card{ background:var(--card); border:1px solid var(--card-border); border-radius:16px; overflow:hidden; }
  .proof-card img{ width:100%; display:block; }
  .proof-body{ padding:20px; }
  .proof-tag{ display:inline-block; background:#0E2A26; color:var(--teal); font-size:11px; font-weight:700; padding:4px 10px; border-radius:6px; letter-spacing:0.03em; }
  .proof-body h4{ margin-top:12px; font-size:15.5px; }
  .proof-body .hint{ margin-top:8px; font-size:12.5px; color:var(--text-soft); }

  .case-detail{ margin-top:56px; }
  .case-detail h3{ font-size:20px; }
  .case-meta-grid{ margin-top:18px; display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; }
  .case-mini{ background:var(--card); border:1px solid var(--card-border); border-radius:12px; padding:18px; text-align:center; }
  .case-mini .cm-num{ font-size:19px; font-weight:800; color:var(--teal); }
  .case-mini .cm-label{ font-size:12px; color:var(--text-soft); margin-top:4px; }
  .case-cols{ margin-top:18px; display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  .case-box{ background:var(--card); border:1px solid var(--card-border); border-radius:12px; padding:20px; }
  .case-box h5{ font-size:13.5px; color:var(--blue); font-weight:700; margin-bottom:10px; text-transform:uppercase; letter-spacing:0.03em; }
  .case-box li{ position:relative; padding-left:16px; font-size:13.5px; color:var(--text-soft); margin-bottom:8px; }
  .case-box li::before{ content:"›"; position:absolute; left:0; color:var(--teal); }
  .case-block + .case-block{ margin-top:48px; padding-top:48px; border-top:1px dashed var(--card-border); }

  /* ---- Contact ---- */
  .contact{ padding:80px 0; border-top:1px solid var(--card-border); }
  .contact-grid{ margin-top:40px; display:grid; grid-template-columns:0.75fr 1.25fr; gap:24px; align-items:start; }
  .info-card{ background:var(--card); border:1px solid var(--card-border); border-radius:14px; padding:20px; display:flex; align-items:center; gap:14px; margin-bottom:14px; }
  .info-icon{ width:42px; height:42px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .info-label{ font-size:11.5px; color:var(--text-soft); }
  .info-value{ font-size:14.5px; font-weight:700; }
  .wa-btn{
    display:flex; align-items:center; justify-content:center; gap:10px;
    background:transparent; border:1px solid #1E3B2E; color:var(--green);
    padding:16px; border-radius:14px; font-weight:700; font-size:14.5px;
  }
  .form-card{ background:var(--card); border:1px solid var(--card-border); border-radius:16px; padding:30px; }
  .form-row{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .field{ margin-bottom:18px; }
  .field label{ font-size:12px; font-weight:700; letter-spacing:0.03em; color:var(--text-soft); display:block; margin-bottom:8px; }
  .field input, .field textarea{
    width:100%; background:#0D1420; border:1px solid var(--card-border); border-radius:10px;
    padding:12px 14px; color:var(--text); font-family:inherit; font-size:14px;
  }
  .field textarea{ min-height:100px; resize:vertical; }
  .field input::placeholder, .field textarea::placeholder{ color:#5A6479; }
  .submit-btn{
    width:100%; background:var(--grad); color:#04121C; border:none;
    padding:15px; border-radius:10px; font-weight:800; font-size:14.5px; cursor:pointer;
  }
  .map-frame{
    margin-top:24px; border-radius:16px; overflow:hidden; border:1px solid var(--card-border);
    background:
      radial-gradient(circle at 30% 30%, rgba(59,130,246,0.15), transparent 50%),
      radial-gradient(circle at 70% 70%, rgba(45,212,191,0.12), transparent 50%),
      #0D1420;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size:100% 100%, 32px 32px, 32px 32px;
    height:220px;
    display:flex; align-items:center; justify-content:center; flex-direction:column; gap:10px;
  }
  .map-frame .pin{ width:44px; height:44px; border-radius:50%; background:var(--grad); display:flex; align-items:center; justify-content:center; }
  .map-frame .city{ font-weight:700; font-size:15px; }
  .map-frame .country{ font-size:13px; color:var(--text-soft); }

  /* ---- Footer ---- */
  footer{ padding:30px 0; border-top:1px solid var(--card-border); }
  footer .wrap{ display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; font-size:13px; color:var(--text-soft); }
  footer strong{ color:var(--text); }

  @media (max-width:860px){
    .hero .wrap{ grid-template-columns:1fr; }
    .hero-photo-wrap{ order:-1; margin-bottom:10px; }
    .about-grid{ grid-template-columns:1fr; }
    .skills-grid{ grid-template-columns:1fr 1fr; }
    .services-grid{ grid-template-columns:1fr 1fr; }
    .proof-grid{ grid-template-columns:1fr 1fr; }
    .case-meta-grid{ grid-template-columns:1fr; }
    .case-cols{ grid-template-columns:1fr; }
    .contact-grid{ grid-template-columns:1fr; }
    .form-row{ grid-template-columns:1fr; }
    nav{ display:none; }
    .float-badge{ display:none; }
    .stat-grid{ grid-template-columns:1fr; }
  }
  @media (max-width:560px){
    .skills-grid, .services-grid, .proof-grid{ grid-template-columns:1fr; }
    .hero h1{ font-size:32px; }
  }
</style>
</head>
